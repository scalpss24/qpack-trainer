{
  "name": "QPack Тренажёр",
  "short_name": "QPack",
  "description": "Офлайн-тренажёр тестов и карточек из пакетов .qpack",
  "start_url": "./index.html",
  "display": "standalone",
  "background_color": "#0f172a",
  "theme_color": "#4f46e5",
  "icons": [
    {
      "src": "./icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "./index.html",
      "accept": {
        "application/x-qpack": [".qpack"],
        "application/zip": [".qpack"]
      }
    }
  ]
}
